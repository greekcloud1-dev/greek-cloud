# The website's own configuration. Never commit real values.

# Notification email for a new request.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=

# Where a submission is stored: the CRM's Supabase project.
#
# SUPABASE_STORAGE_KEY must be a key scoped to Storage and nothing else. The
# public website must not be able to read the CRM database -- if this site is
# ever compromised, what is reachable should be the files, not every customer.
# The record itself travels through the authenticated bridge below, which the
# CRM owns and which holds the privileged key.
SUPABASE_URL=
SUPABASE_STORAGE_KEY=

# The bridge that files a submission as a CRM case. The same secret goes on
# both projects, 32 characters or more.
CRM_INGEST_URL=
CRM_INGEST_SECRET=

# Holding area only. Nothing is written here when the normal path works: it
# catches a submission when Supabase or the bridge refuses, so nobody is lost
# while a provider is down. Anything under `unreceived/` is waiting to be
# recovered, and that prefix existing at all is the alert.
BLOB_READ_WRITE_TOKEN=
