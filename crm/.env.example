# Supabase (required for production CRM persistence and invite-only login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=

# Public app origin and server-only secret for scheduled notification workers
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
CRM_INGEST_SECRET=

# Outgoing email notifications (optional until an email provider is connected)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Both keys are required before public intake can accept any submissions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WhatsApp Business Platform / Cloud API (future optional integration only).
# Deep-link buttons in the MVP do not require these values.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Viewing a public intake's selfie or prescription from inside a case.
# The website keeps the files; the CRM mints a five-minute signed link and the
# staff member's browser fetches it from the website. Both sides must hold the
# SAME secret, at least 32 characters, and it must never reach a browser.
#   INTAKE_FILE_SECRET  - also set on the website project
#   INTAKE_FILE_ORIGIN  - the website's origin, e.g. https://greek-cloud.com
# Leave both blank and the file buttons report that viewing is not configured;
# everything else in the case still works.
INTAKE_FILE_SECRET=
INTAKE_FILE_ORIGIN=
