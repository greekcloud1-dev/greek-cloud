{
  "name": "greekcloud",
  "private": true,
  "type": "module",
  "description": "GreekCloud static site. No build step for the site itself -- this file exists so Vercel installs dependencies for the functions in /api (intake + CRM).",
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "nodemailer": "^10.0.10"
  },
  "scripts": {
    "test": "node --test --experimental-test-module-mocks \"tests/*.test.mjs\"",
    "crm:dev": "node dev/crm-dev-server.mjs",
    "check": "node scripts/check-seo.mjs",
    "check:dup": "node scripts/check-duplication.mjs && node scripts/check-duplication.mjs --en",
    "check:canaflight": "node scripts/check-canaflight.mjs",
    "check:all": "npm run check && npm run check:dup",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "indexnow": "node scripts/indexnow-submit.mjs"
  }
}
